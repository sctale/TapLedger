# TapLedger Server — 配置模板（入库示例）
# 首次部署：复制为 .env 并填入你的真实密钥：cp .env.example .env
# JWT 签名密钥：随机长字符串（建议 ≥32 位）。生产环境（镜像默认 NODE_ENV=production）
# 若缺失/等于默认值/短于 16 位，容器会拒绝启动——这是防伪造 token 的保护，不是 bug。
JWT_SECRET=please-change-me-to-a-long-random-string

# 自动备份（可选，不配即默认）：每日热备份到 data/backups/，保留份数与开关
#BACKUP_KEEP=7
#BACKUP_DISABLED=1

# 管理面板口令（可选，v0.5.0）：配置后浏览器打开 https://你的域名/admin，
# 输入此口令即可在线开关「允许注册 / 允许加入家庭」（即时生效，无需重启）。
# 不配置则面板接口返回 503（等于没有面板，零暴露）。建议 ≥32 位随机串。
#ADMIN_TOKEN=another-long-random-string